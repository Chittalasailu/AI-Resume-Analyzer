# Google Gemini API key (SDK is wired up in requirements.txt; not yet called by app/ai.py)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret used to sign JWT access tokens.
# Falls back to an insecure default ("dev-secret-key") if unset locally, but is REQUIRED when
# running on Render (the app refuses to start without it there).
JWT_SECRET=your_jwt_secret_here

# Optional: an additional frontend origin to allow via CORS, on top of the defaults
# already in app/main.py (localhost dev ports + the known Vercel deployments).
FRONTEND_URL=https://ai-resume-analyzer-sailu1.vercel.app
