# Google Gemini API key (SDK is wired up in requirements.txt; not yet called by app/ai.py)
GEMINI_API_KEY=your_gemini_api_key_here

# Secret used to sign JWT access tokens.
# Falls back to an insecure default ("dev-secret-key") if unset — always set a strong value outside local dev.
JWT_SECRET=your_jwt_secret_here
