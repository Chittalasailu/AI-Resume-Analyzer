# Google Gemini API key, used by app/ai.py to generate resume analyses.
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string for persistent storage (users + resume analyses).
# Falls back to a local SQLite file when unset, for local development only.
# REQUIRED when running on Render -- the app refuses to start without it there.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign JWT access tokens. Generate one with:
#   openssl rand -hex 32
# Falls back to an insecure development-only default if unset locally, but is REQUIRED
# when running on Render (the app refuses to start without it there).
JWT_SECRET=your_jwt_secret_here

# Optional: an additional frontend origin to allow via CORS, on top of the defaults
# already in app/main.py (localhost dev ports + the known Vercel deployments).
FRONTEND_URL=https://ai-resume-analyzer-sailu1.vercel.app
